# Dev-only PHP CLI image for local `artisan`/test runs inside docker.
# Local PHP lacks pgsql; the prod image runs php-fpm with --no-dev.
# NOT for production. Build via compose.dev.yaml service `workspace`.
FROM php:8.4-cli-alpine
# gd matches the app image: the catalogue PDF re-encodes photos as JPEG (ADR-052).
RUN apk add --no-cache icu-libs libpq libzip freetype libjpeg-turbo libpng libwebp \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev postgresql-dev libzip-dev oniguruma-dev \
       freetype-dev libjpeg-turbo-dev libpng-dev libwebp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) bcmath gd intl mbstring opcache pcntl pdo_pgsql zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && printf 'upload_max_filesize=12M\npost_max_size=13M\n' > /usr/local/etc/php/conf.d/uploads.ini
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
CMD ["php", "-a"]
