# PUBLIC_DOMAIN must resolve to the VPS public IP before automatic TLS works.
# Behind a host proxy (deploy/server: Apache terminates TLS) set PUBLIC_DOMAIN
# to ":80"; Caddy then keeps that proxy's X-Forwarded-* headers because it
# connects from a private address. Public clients are never trusted.
{
    servers {
        trusted_proxies static private_ranges
    }
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    root * /srv/public
    request_body {
        max_size 25MB
    }
    php_fastcgi app:9000 {
        # PHP and the static web image intentionally use different filesystem roots.
        root /var/www/html/public
    }
    file_server

    # Telegram Web clients open the Mini App in an iframe from web.telegram.org;
    # mobile/desktop clients use a webview. Only /app may be framed, only by Telegram.
    @miniapp path /app /app/*
    header @miniapp {
        Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://web.telegram.org"
    }
    @notMiniapp not path /app /app/*
    header @notMiniapp {
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'"
    }
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output stdout
        format json
    }
}
