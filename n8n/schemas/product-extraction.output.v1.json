{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karmandeman.invalid/schemas/product-extraction.output.v1.json",
  "title": "Product extraction run result (n8n -> Laravel callback), ADR-032",
  "description": "POST to callback_url, signed with N8N_CALLBACK_SECRET (same header scheme as the input). Laravel enforces this schema and more (draft field limits, cited photos within the run, usage caps); this file is the contract for the workflow author. Every value becomes 'suggested'; a price is only read from the photos, never estimated, and always carries its unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "usage",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "product-extraction.output.v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_requests",
        "input_tokens",
        "output_tokens",
        "provider",
        "model"
      ],
      "properties": {
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "Empty when status is failed; at most limits.max_candidates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sku",
          "description_fa",
          "price",
          "attributes",
          "category_path",
          "source_asset_ids"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 1
          },
          "sku": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "minLength": 1
          },
          "description_fa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000,
            "minLength": 1
          },
          "price": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "amount",
              "unit"
            ],
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999999999
              },
              "unit": {
                "enum": [
                  "IRR",
                  "IRT"
                ]
              }
            }
          },
          "attributes": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "values"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "values": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1
                  }
                }
              }
            }
          },
          "category_path": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1
            }
          },
          "source_asset_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "description": "Every text must keep a visible character after Persian normalization (ZWNJ or tatweel only is refused)."
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      }
    }
  ]
}
