{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karmandeman.invalid/schemas/product-extraction.input.v1.json",
  "title": "Product extraction run input (Laravel -> n8n), ADR-032",
  "description": "Signed with N8N_WORKFLOW_AUTH_TOKEN: X-KM-Timestamp and X-KM-Signature = v1=hex(HMAC-SHA256(secret, timestamp + '.' + raw body)). Names photos by public id with a run-scoped signed download link; no workspace, brand, chat or file bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_version",
    "run_id",
    "project_id",
    "attempt",
    "locale",
    "assets",
    "limits",
    "deadline_at",
    "callback_url"
  ],
  "properties": {
    "schema_version": {
      "const": "product-extraction.input.v1"
    },
    "workflow_version": {
      "type": "string",
      "maxLength": 64
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa-IR"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mime",
          "size_bytes",
          "width",
          "height",
          "download_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mime": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "description": "GET within deadline_at returns the photo without metadata (EXIF/GPS, XMP, IPTC, comments). Refused with 403 once the run closes, its deadline passes or the account is being erased. Never store or forward it (ADR-033)."
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_candidates",
        "max_model_requests",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "max_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "callback_url": {
      "type": "string",
      "format": "uri"
    }
  }
}
