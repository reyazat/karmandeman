PUBLIC_DOMAIN=localhost
APP_NAME=Karmandeman
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=REPLACE_OR_GENERATE
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
DB_CONNECTION=pgsql
# compose.dev.yaml maps infra to 127.0.0.1:55432/56379; docker names are for in-container runs
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=km_app
DB_USERNAME=km_app
DB_PASSWORD=REPLACE_OR_GENERATE
PG_APP_DB=km_app
PG_APP_USER=km_app
PG_APP_PASSWORD=REPLACE_OR_GENERATE
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=REPLACE_OR_GENERATE
REDIS_CLIENT=phpredis
N8N_DB_NAME=km_n8n
N8N_DB_USER=km_n8n
N8N_DB_PASSWORD=REPLACE_OR_GENERATE
N8N_ENCRYPTION_KEY=REPLACE_OR_GENERATE
# Local dev: no bundled n8n runs, so BOTH URLs point at the remote instance.
# If you ever run `--profile bundled-n8n`, revert these two to http://n8n:5678.
N8N_INTERNAL_URL=https://example.invalid
N8N_API_URL=https://example.invalid
N8N_API_KEY=REPLACE_OR_GENERATE
N8N_WORKFLOW_AUTH_TOKEN=REPLACE_OR_GENERATE
TELEGRAM_BOT_TOKEN=REPLACE_OR_GENERATE
TELEGRAM_WEBHOOK_SECRET=REPLACE_OR_GENERATE
# One-time signup gift credits (PRD E08); 0 disables the grant.
KM_GIFT_CREDITS=100
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=REPLACE_OR_GENERATE
AWS_SECRET_ACCESS_KEY=REPLACE_OR_GENERATE
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=km-local
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
