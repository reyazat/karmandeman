# Example ONLY. Never commit production secrets; use chmod 600 and keep out of
# the Docker build context. Pass only via --env-file; do not treat environment
# variables as a secret store (docker inspect exposes container environments).
PUBLIC_DOMAIN=api.karmandeman.ir
APP_NAME=Karmandeman
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.karmandeman.ir
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_show
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
DB_CONNECTION=pgsql
DB_HOST=postgres_app
DB_PORT=5432
DB_DATABASE=km_app
DB_USERNAME=km_app
DB_PASSWORD=REPLACE_STRONG_APP_DB_PASSWORD
PG_APP_DB=km_app
PG_APP_USER=km_app
PG_APP_PASSWORD=REPLACE_STRONG_APP_DB_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
# Redis password must contain only letters, digits, underscore or hyphen.
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD
REDIS_CLIENT=phpredis
N8N_DB_NAME=km_n8n
N8N_DB_USER=km_n8n
N8N_DB_PASSWORD=REPLACE_STRONG_N8N_DB_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_LONG_RANDOM_KEY_STABLE_BACKUP
N8N_INTERNAL_URL=http://n8n:5678
# n8n public REST API, used by Laravel to manage/execute workflows.
# n8n runs as a standalone container on the same host: use either its public
# URL (https://ai.smartystudio.co.uk) or, if the app shares a docker network
# with that container, http://<n8n-container-name>:5678.
N8N_API_URL=https://ai.smartystudio.co.uk
N8N_API_KEY=REPLACE_N8N_PUBLIC_API_JWT
N8N_WORKFLOW_AUTH_TOKEN=REPLACE_PRIVATE_TOKEN_WITH_ROTATION_PLAN
TELEGRAM_BOT_TOKEN=REPLACE_BOT_FATHER_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_TELEGRAM_SECRET_ALLOWED_CHARS
# One-time signup gift credits (PRD E08); 0 disables the grant.
KM_GIFT_CREDITS=100
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=REPLACE_S3_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_S3_SECRET
AWS_DEFAULT_REGION=REPLACE_REGION
AWS_BUCKET=REPLACE_PRIVATE_BUCKET
AWS_ENDPOINT=https://REPLACE_S3_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false

# Self-hosted OpenBao Transit on a separate host (ADR-013); use an AppRole-issued token, never root.
OPENBAO_ADDR=https://openbao.example.invalid
OPENBAO_TOKEN=
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_KEY_PREFIX=ws-
